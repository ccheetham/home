# ============================================================================
# msmtp
# ----------------------------------------------------------------------------
# http://msmtp.sourceforge.net/
#
# Example getting Google's SMTP fingerprint:
#     $ openssl s_client -connect smtp.gmail.com:587 -starttls smtp \
#           < /dev/null 2> /dev/null \
#           | openssl x509 -fingerprint -noout \
#           | cut -d'=' -f2
# ============================================================================

# defaults
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/cert.pem

# me

account me
host smtp.gmail.com
port 587
auth on
from chris@cheetham.com
user chris@cheetham.com
passwordeval cat ~/.gmail-neomutt-password
#tls on
#tls_fingerprint D3:7C:82:FC:D0:5F:8F:D7:DA:A2:59:8C:42:D7:B2:9F:C1:9F:7E:60
logfile ~/.local/var/log/msmtp/me.log

# ---- misc ------------------------------------------------------------------

account default: me
