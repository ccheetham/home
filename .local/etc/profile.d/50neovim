export NVIM_APPNAME=nvim

if hascmd nvim; then
  alias vi=nvim
  alias view='nvim -R'
fi

vic() {
  cd $XDG_CONFIG_HOME/$NVIM_APPNAME
  echo ${(D)$(pwd)}
}

