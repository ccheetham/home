# =============================================================================
# finalize path setups
# =============================================================================

ME_MANPATH+=:$HOMEBREW_HOME/man
ME_PATH+=:$HOMEBREW_HOME/bin:$HOMEBREW_HOME/sbin

if [[ solaris == $ME_OS ]] ; then
  if [[ ! -d /opt/csw ]] ; then
    echo OpenCSW not installed: pkgadd -d http://get.opencsw.org/now
  fi
  ME_PATH+=:/opt/csw/bin
  ME_MANPATH+=:/opt/csw/share/man
  ME_PATH+=:/usr/gnu/bin
  ME_MANPATH+=:/usr/gnu/share/man
fi

[[ osx == $ME_PS ]] || PATH=/bin:/usr/bin
[ -f /etc/profile ] && source /etc/profile

PATH=$ME_PATH:$PATH
if [[ $ME_MANPATH == :* ]]; then
  ME_MANPATH=${ME_MANPATH[2,-1]}
fi
MANPATH=$ME_MANPATH:$MANPATH

