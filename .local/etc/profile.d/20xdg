xdg() {
  env | grep XDG
}

dxdg() {
  cdp $XDG_CONFIG_HOME
}

dxdgc() {
  cdp $XDG_CACHE_HOME
}

dxdgd() {
  cdp $XDG_DATA_HOME
}

