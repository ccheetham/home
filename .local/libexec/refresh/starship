#/usr/bin/bash

source $ME_LIBEXEC_DIR/sh_functions

set -e

header() {
  local filename=$1
  echo '# ============================================================================='
  echo '# '$filename
  echo '# ============================================================================='
  echo
}

main () {
  hdr "refreshing starship:"
  if [[ -z $STARSHIP_CONFIG ]] ; then
    die "STARSHIP_CONFIG env var not defined"
  fi
  parent=$(dirname $STARSHIP_CONFIG)
  mkdir -p $(dirname $parent)
  rm -f $STARSHIP_CONFIG
  touch $STARSHIP_CONFIG
  for toml in $parent/[0-9]*.toml; do
    msg "  adding $toml"
    header $toml >> $STARSHIP_CONFIG
    cat $toml >> $STARSHIP_CONFIG
  done
}

main $@

