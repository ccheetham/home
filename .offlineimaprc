[general]
accounts = me
fsync = false

[Account me]
localrepository = me-local
remoterepository = me-remote

[Repository me-local]
type = Maildir
localfolders = $ME_MAIL_DIR/me

[Repository me-remote]
type = Gmail
remoteuser = chris@cheetham.com
remotepassfile = ~/.gmail-neomutt-password
maxconnections = 3
sslcacertfile = /etc/ssl/cert.pem
folderfilter = lambda folder: folder in [
    'INBOX',
    '[Gmail]/All Mail',
    '[Gmail]/Drafts',
    '[Gmail]/Sent Mail',
    '[Gmail]/Starred',
    '[Gmail]/Trash',
    ]
nametrans = lambda folder: {
    '[Gmail]/All Mail':  'allmail',
    '[Gmail]/Sent Mail': 'sent',
    '[Gmail]/Drafts':    'drafts',
    '[Gmail]/Trash':     'trash',
    '[Gmail]/Starred':   'starred',
    }.get(folder, folder)
